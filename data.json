 удобное расположение рядом с магазинами, кафе и основными транспортными маршрутами.\n\n🔥🔥Стоимость аренды: 30 000 бат в месяц при заключении годового контракта.\n\n🔥Отличный вариант для тех, кто ищет комфортное жилье на длительный срок в одном из лучших районов Пхукета.","status":"draft","plannedDate":"","createdAt":1790577167832,"updatedAt":1790585269825,"photos":[{"id":"5e067fe2-5fa4-4b32-af89-1c5b238502aa","name":"01.jpg","path":"photos/bellevue-lagoon-studio/01.jpg"},{"id":"695dc8ba-fd1c-417f-be0e-3a061e9a9f11","name":"02.jpg","path":"photos/bellevue-lagoon-studio/02.jpg"},{"id":"df27415b-fedf-4306-ba17-4cd33b37cbdc","name":"03.jpg","path":"photos/bellevue-lagoon-studio/03.jpg"},{"id":"41b143a7-cdbd-44fa-b4a3-94a371cb9435","name":"04.jpg","path":"photos/bellevue-lagoon-studio/04.jpg"},{"id":"5bc74aaa-6302-4642-96da-a6a6eb8b0c17","name":"05.jpg","path":"photos/bellevue-lagoon-studio/05.jpg"},{"id":"50d6e933-bcfc-409c-9be9-8963bb27ac57","name":"06.jpg","path":"photos/bellevue-lagoon-studio/06.jpg"},{"id":"c63eb0a4-8648-44a7-92f7-2cf36e8f09cb","name":"07.jpg","path":"photos/bellevue-lagoon-studio/07.jpg"},{"id":"84e7f12d-2dc9-432e-9ca7-959c731bbe43","name":"08.jpg","path":"photos/bellevue-lagoon-studio/08.jpg"},{"id":"172f331c-ae38-4bb7-9f8b-6f48823297d7","name":"09.jpg","path":"photos/bellevue-lagoon-studio/09.jpg"},{"id":"7fe0afbb-b4af-411b-85d8-124f373e3d3c","name":"10.jpg","path":"photos/bellevue-lagoon-studio/10.jpg"},{"id":"827911ad-ead6-4afd-a568-0191afc1fafd","name":"11.jpg","path":"photos/bellevue-lagoon-studio/11.jpg"},{"id":"106e4c52-a6a4-45bc-97d8-92279d00f803","name":"12.jpg","path":"photos/bellevue-lagoon-studio/12.jpg"}]},{"id":"eaed8cb1-526e-454d-b4ae-13b75cc3d597","cat":"realty","text":"Townhouse 140","status":"draft","plannedDate":"","createdAt":1790577182832,"updatedAt":1790577182832,"photos":[{"id":"f26038b0-c99e-4813-8f81-64c24e529d6d","name":"01.jpg","path":"photos/townhouse-140/01.jpg"},{"id":"5d303247-0f1d-448b-bf5d-4aed2882570d","name":"02