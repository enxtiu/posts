"11.jpg","path":"photos/la-vita-rawai-56sqm/11.jpg"},{"id":"ee699de1-3da9-4cd2-8be5-c5f297b9cb65","name":"12.jpg","path":"photos/la-vita-rawai-56sqm/12.jpg"}]},{"id":"6f0f0524-6747-4fe5-ac04-2d74ab5c9e88","cat":"realty","text":"🌊 Sunshine Phuket — действительно редкое предложение у моря\n\n60 КВ.М\n\n🔥🔥65 тыс бат/ месяц🔥🔥\n\nПросторные 2-спальные апартаменты с видом на море — тот случай, когда совпадает всё: локация, комфорт и атмосфера ✨\nДо пляжа всего 2 минуты пешком — можно выходить на утренний кофе с видом на океан ☕🌴\n\n🏡 Что внутри и рядом:\n— 2 отдельные спальни — удобно для семьи или гостей 🛏️\n— Вид на море, который не надоедает 🌅\n— Круглосуточный спортзал — тренируйтесь в любое время 💪\n— Паркинг — без лишних забот 🚗\n— Всё рядом: кафе, магазины, рестораны, инфраструктура 🍜🛍️\n\nЭто не просто аренда или покупка — это формат жизни, в который легко влюбиться 💛\nПодходит и для жизни, и как инвестиция 📈\n\nДоступна к покупке.","status":"draft","plannedDate":"","createdAt":1790577181832,"updatedAt":1790585269825,"photos":[{"id":"e5098990-0f8e-492c-ba36-8d10ae18723c","name":"01.jpg","path":"photos/sunshine-60sqm/01.jpg"},{"id":"c20d5077-41a2-4026-b51f-a2282f105dcf","name":"02.jpg","path":"photos/sunshine-60sqm/02.jpg"},{"id":"e74164a3-84f4-44af-b30b-55260a95cac4","name":"03.jpg","path":"photos/sunshine-60sqm/03.jpg"},{"id":"c3d4451e-d4e1-4812-8ca0-9c72c27d0daa","name":"04.jpg","path":"photos/sunshine-60sqm/04.jpg"},{"id":"6c79e3c6-8792-4da0-839b-d293bd2cc4fc","name":"05.jpg","path":"photos/sunshine-60sqm/05.jpg"},{"id":"ced5e1f5-0f6d-4f07-9949-c3e0cc70ce83","name":"06.jpg","path":"photos/sunshine-60sqm/06.jpg"},{"id":"dca46b21-3042-4991-ba34-40fc34138354","name":"07.jpg","path":"photos/sunshine-60sqm/07.jpg"},{"id":"9afa42fa-ccdd-45e1-aff8-f9cc83266c5b","name":"08.jpg","path":"photos/sunshine-60sqm/08.jpg"},{"id":"aed4284a-a280-4490-b726-d26225b668d9","name":"09.jpg","path":"photos/sunshine-60sqm/09.jpg"},{"id":"e19bf25a-9544-4f85-8d2b-9a0599a18314","name":"10